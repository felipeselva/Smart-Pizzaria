<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Criar Conta - Pizzaria Smart</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white h-screen flex items-center justify-center">
    <div class="bg-gray-800 p-8 rounded-lg shadow-lg w-96">
        <h1 class="text-3xl font-bold text-center mb-6 text-orange-500">🍕 Nova Conta</h1>
        <form id="registerForm" class="space-y-4">
            <div>
                <label class="block text-sm mb-1">Nome Completo</label>
                <input type="text" id="nome" class="w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-orange-500 outline-none" required>
            </div>
            <div>
                <label class="block text-sm mb-1">Email</label>
                <input type="email" id="email" class="w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-orange-500 outline-none" required>
            </div>
            <div>
                <label class="block text-sm mb-1">Senha</label>
                <input type="password" id="password" class="w-full p-2 rounded bg-gray-700 border border-gray-600 focus:border-orange-500 outline-none" required>
            </div>
            <button type="submit" class="w-full bg-orange-600 hover:bg-orange-700 font-bold py-2 rounded transition">Cadastrar</button>
        </form>
        <p class="text-center mt-4 text-sm text-gray-400">
            Já tem conta? <a href="/login" class="text-orange-500 hover:underline">Faça Login</a>
        </p>
        <p id="msg" class="text-center mt-4 text-sm hidden"></p>
    </div>

    <script>
        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const nome = document.getElementById('nome').value;
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const msg = document.getElementById('msg');

            try {
                const res = await fetch('/api/v1/auth/register', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ nome, email, password })
                });
                const data = await res.json();

                if (data.success) {
                    msg.innerText = "✅ Conta criada! Redirecionando...";
                    msg.classList.remove('hidden', 'text-red-400');
                    msg.classList.add('text-green-400');
                    setTimeout(() => window.location.href = '/', 1500);
                } else {
                    throw new Error(data.error);
                }
            } catch (err) {
                msg.innerText = err.message || "Erro ao cadastrar";
                msg.classList.remove('hidden');
                msg.classList.add('text-red-400');
            }
        });
    </script>
</body>
</html>